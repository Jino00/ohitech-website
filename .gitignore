node_modules/
.next/
# Runtime data (SQLite DB) stays out of git, but data/_raw/*.json is the crawled
# source the T-Global catalog is regenerated from — without it thermal-catalog.ts
# cannot be rebuilt, so it IS committed. The _ko/_ja/_zh layers are derived
# artifacts of scripts/tglobal/fill-locale.mjs and stay ignored.
/data/*
!/data/_raw/
/data/_raw/_ja/
/data/_raw/_ko/
/data/_raw/_zh/
*.db
.env
.env.local
.DS_Store
.gstack/

# build artifacts / scratch
.next_old/
tmp/
tsconfig.tsbuildinfo
/next
/ohitech-website@1.0.0

# claude local memory / skills (not for repo)
.claude/skills/
.claude/memory/HANDOFF_*.md
.claude/memory/MEMORY.md
.claude/settings.json
.claude/*.png
.claude/*.html
