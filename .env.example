# OHI Tech Website — 환경변수 예시. 실제 값은 .env(.local)에 두고 절대 커밋하지 않는다.

# ── SMTP (문의 알림 메일) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ohitech.co.kr

# ── SEO 자가점검 API (/api/seo-audit) ──
# 외부 마케팅 에이전트가 Authorization: Bearer <token> 으로 호출할 때 사용하는 토큰.
# 길고 무작위인 값으로 설정(예: openssl rand -hex 32). 미설정 시 Bearer 인증은 비활성화되고
# Basic Auth(admin_users 계정)로만 접근 가능.
SEO_AUDIT_TOKEN=

# 점검 대상 base URL. 기본값은 라이브 사이트. 로컬 검증 시 http://localhost:3000 으로 오버라이드.
SEO_AUDIT_BASE_URL=https://www.ohitech.co.kr
